@echo off
rem {PROJECT} autopilot launcher. GENERATED by tools/agents/setup_clone.py --launcher from
rem autopilot.toml; edit those, not this copy. Lives at {LAUNCHER} in the products folder.
rem Double-click to start or restart. Close this window (or create {STOP}) to stop.
title {PROJECT} Autopilot
set "STATE={STATE}"
set "RT=%STATE%\runtime"
if not exist "%STATE%" mkdir "%STATE%"
if not exist "%RT%\.git" git clone -q {REPO} "%RT%"
git -C "%RT%" fetch -q --prune origin
rem Runs origin/main unless %STATE%\runtime-ref.txt names another ref that still exists.
set "REF=origin/main"
if exist "%STATE%\runtime-ref.txt" set /p REF=<"%STATE%\runtime-ref.txt"
git -C "%RT%" rev-parse --verify -q "%REF%" >nul 2>&1 || set "REF=origin/main"
git -C "%RT%" checkout -q --detach --force "%REF%"
echo Running autopilot from %REF%
if not exist "%RT%\tools\agents\supervisor.py" (
  echo %REF% has no tools\agents\supervisor.py yet. Merge the autopilot setup PR first.
  pause
  exit /b 1
)
python "%RT%\tools\agents\supervisor.py"
echo.
echo Autopilot stopped. Double-click {LAUNCHER} to start it again.
pause
